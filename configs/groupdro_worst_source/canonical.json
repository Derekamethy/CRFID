{
  "schema_version": 1,
  "protocol_id": "GROUPDRO_WORST_SOURCE_POSITION_STRICT_DG_V1",
  "canonical_candidate": "C1_FIRST_DIFFERENCE_ERM_1DCNN",
  "source_positions": ["P1", "P2", "P3"],
  "target_position": "P4",
  "seeds": [42, 43, 44, 45, 46],
  "source_folds": {
    "S1": {"held_position": "P1", "training_positions": ["P2", "P3"]},
    "S2": {"held_position": "P2", "training_positions": ["P1", "P3"]},
    "S3": {"held_position": "P3", "training_positions": ["P1", "P2"]}
  },
  "input": {
    "ordered_signal_points": 281,
    "first_difference_points": 280,
    "representation": "first_difference_x_i_plus_1_minus_x_i_without_padding",
    "standardization": "featurewise_population_training_partition_only",
    "ddof": 0,
    "minimum_scale": 1e-12,
    "minimum_scale_replacement": 1.0,
    "fit_dtype": "float64",
    "model_dtype": "float32"
  },
  "model": {
    "implementation": "crfid.strict_runtime.neutral_model.NeutralSourceOnlyCNN1D",
    "class_count": 7,
    "embedding_dimension": 256,
    "parameter_count": 142855
  },
  "optimizer": {
    "name": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "betas": [0.9, 0.999],
    "epsilon": 1e-8,
    "amsgrad": false,
    "foreach": false,
    "fused": false
  },
  "loss": {
    "name": "unweighted_cross_entropy",
    "weight": null,
    "label_smoothing": 0.0
  },
  "training": {
    "batch_size": 256,
    "maximum_inner_epochs": 50,
    "early_stopping_patience": 8,
    "minimum_improvement": 1e-12,
    "inner_stage_offset": 0,
    "outer_stage_offset": 100000,
    "scheduler": null,
    "checkpoint_rule": "source_validation_TagID_Macro_F1_earliest_strict_improvement",
    "outer_refit_rule": "reinitialize_same_seed_and_train_source_development_for_selected_epoch_count"
  },
  "sampler": {
    "name": "deterministic_source_position_balanced_class_interleaved",
    "replacement_policy": "repeat_only_after_all_original_position_rows_consumed",
    "incomplete_final_batch": "retain_with_every_active_source_position_represented",
    "shared_between_erm_and_groupdro": true
  },
  "groupdro": {
    "group_variable": "source_position",
    "eta_grid": [0.01, 0.05, 0.1, 0.2],
    "initial_q": "uniform",
    "update": "q_g <- q_g * exp(eta * detached_mean_group_cross_entropy); normalize",
    "update_frequency": "optimizer_step",
    "q_momentum": null,
    "q_clipping": null,
    "numerical_stabilization": "subtract_maximum_log_weight_before_exp",
    "epsilon": 1e-12
  },
  "eta_selector": {
    "step_1": "maximize_mean_held_source_Macro_F1",
    "step_2": "eligible_within_0.01_of_best_mean",
    "step_3": "maximize_minimum_held_position_mean_Macro_F1",
    "step_4": "within_0.005_minimum_choose_lower_population_sd",
    "step_5": "within_0.001_sd_choose_smaller_eta"
  },
  "p4_label_seal": {
    "unlabelled_files": ["p4_signals_float64.npy", "p4_unlabelled_registry.csv"],
    "sealed_label_file": "p4_labels_int64.npy",
    "prediction_freeze_required_before_label_open": true,
    "primary_unit": "TagID_x_ER_x_surface_condition_block",
    "rows_per_block": 50,
    "vote_tie_rule": "lowest_frozen_global_class_order"
  },
  "uncertainty": {
    "p4_primary": "paired_TagID_stratified_condition_block_bootstrap",
    "source_primary": "paired_held_position_seed_bootstrap",
    "resamples": 10000,
    "seed": 20260804
  }
}
